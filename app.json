{
  "expo": {
    "name": "ReHome",
    "slug": "rehome-mobile",
    "owner": "tranthimyhanhs-team",
    "scheme": "rehome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rehome.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logoIcon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F9F4"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "ReHome cần truy cập thư viện ảnh để bạn chọn ảnh sản phẩm ký gửi, ảnh đại diện và giấy tờ.",
          "cameraPermission": "ReHome cần dùng camera để bạn chụp ảnh sản phẩm ký gửi, CCCD và giấy tờ."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ReHome dùng vị trí để gợi ý kho ký gửi gần bạn."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3b69c8e6-0973-4f95-af12-f271e8fec947"
      }
    }
  }
}
